<Window x:Class="Notlar.PasswordDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Notlar" Style="{StaticResource {x:Type Window}}" Width="440" SizeToContent="Height" WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False">
  <Border BorderBrush="{DynamicResource Rule}" BorderThickness="1" Padding="28,24">
    <StackPanel>
      <TextBlock x:Name="Heading" FontSize="20" FontWeight="SemiBold"/>
      <TextBlock x:Name="Message" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" LineHeight="21" Margin="0,10,0,18"/>
      <PasswordBox x:Name="Password" AutomationProperties.Name="{local:T BackupPasswordTitle}"/>
      <PasswordBox x:Name="Confirm" Margin="0,10,0,0" AutomationProperties.Name="{local:T BackupPasswordConfirm}"/>
      <TextBlock x:Name="Error" Foreground="{DynamicResource Danger}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
        <Button Content="{local:T Cancel}" Padding="16,10" Margin="0,0,8,0" IsCancel="True"/>
        <Button x:Name="Submit" Content="{local:T OK}" Style="{StaticResource Primary}" Padding="20,10" IsDefault="True" Click="SubmitClick"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
